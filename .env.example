# Configure these as Sites server environment secrets, never browser variables.
# An OpenAI-compatible provider supporting JSON chat completions is required.
MODEL_API_KEY=
# HTTPS base URL including the provider API version, without /chat/completions
MODEL_BASE_URL=
MODEL_NAME=
# Optional overrides: coach model must support Chat Completions function calling.
COACH_MODEL_NAME=
# Image transcription requires an image-capable Chat Completions model.
VISION_MODEL_NAME=
